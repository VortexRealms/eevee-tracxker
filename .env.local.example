# --- Vercel / production runtime (required on deploy) ---
APP_USERNAME=your_username_here
APP_PASSWORD=your_password_here
SESSION_SECRET=change_me_to_a_long_random_string

GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...key contents...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# --- Local scripts only (fetch:pokewallet-ids, fetch:prices — not needed on Vercel) ---
POKEWALLET_API_KEY=pk_live_your_key_here

# Optional Pokewallet rate-limit tuning (defaults: 100/hr, 1000/day, margin 1)
# POKEWALLET_MAX_PER_HOUR=100
# POKEWALLET_MAX_PER_DAY=1000
# POKEWALLET_RATE_MARGIN=1
