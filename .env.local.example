# --- Vercel / production runtime (required on deploy) ---
APP_USERNAME=your_username_here
APP_PASSWORD=your_password_here
SESSION_SECRET=change_me_to_a_long_random_string

# Stable UUID for the primary app user (collection owner). Generate once and keep fixed.
APP_USER_ID=11111111-1111-1111-1111-111111111111
# Public showcase reads this user's owned slots (defaults to APP_USER_ID).
PUBLIC_COLLECTION_USER_ID=11111111-1111-1111-1111-111111111111

# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Alternative name supported by scripts:
# SUPABASE_DB_URL=

# Optional: during cutover only, read prices from Google Sheets when SQLite is empty
# USE_GOOGLE_SHEETS_FALLBACK=true

# --- Legacy Google Sheets (migration + optional fallback only) ---
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...key contents...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# --- Local scripts only (fetch:pokewallet-ids, fetch:prices — not needed on Vercel) ---
POKEWALLET_API_KEY=pk_live_your_key_here

# Restore target for npm run restore:user-db (local/test Postgres only — never production)
# RESTORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eevee_tracker_dev

# Optional Pokewallet rate-limit tuning (defaults: 100/hr, 1000/day, margin 1)
# POKEWALLET_MAX_PER_HOUR=100
# POKEWALLET_MAX_PER_DAY=1000
# POKEWALLET_RATE_MARGIN=1
